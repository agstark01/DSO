moved = 0
for fp in board.GetFootprints():
    ref = fp.GetReference()
    if ref in layout_plan:
        x, y, rot, flip_back = layout_plan[ref]
        if flip_back and not fp.IsFlipped():
            fp.Flip(fp.GetPosition(), False)
        elif not flip_back and fp.IsFlipped():
            fp.Flip(fp.GetPosition(), False)
        fp.SetPosition(pcbnew.VECTOR2I_MM(x, y))
        fp.SetOrientationDegrees(rot)
        moved += 1

# Draw new compact 68mm x 58mm board outline on Edge.Cuts (X: 99..167, Y: 90..148)
edge_layer = board.GetLayerID("Edge.Cuts")
corners = [(99.0, 90.0), (167.0, 90.0), (167.0, 148.0), (99.0, 148.0)]
for i in range(4):
    seg = pcbnew.PCB_SHAPE(board)
    seg.SetShape(pcbnew.SHAPE_T_SEGMENT)
    seg.SetLayer(edge_layer)
    seg.SetStart(pcbnew.VECTOR2I_MM(*corners[i]))
    seg.SetEnd(pcbnew.VECTOR2I_MM(*corners[(i + 1) % 4]))
    seg.SetWidth(pcbnew.FromMM(0.15))
    board.Add(seg)

pcbnew.Refresh()
print(f"Optimized {moved} footprints into 68x58mm floorplan!")